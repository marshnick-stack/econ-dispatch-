{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "event.getaheadsup.com" }],
      "destination": "/talk"
    },
    { "source": "/dispatch", "destination": "/index.html" }
  ],
  "functions": {
    "api/digest.js": {
      "maxDuration": 60
    },
    "api/email-digest.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email-digest",
      "schedule": "0 22 * * 0-4"
    }
  ]
}
