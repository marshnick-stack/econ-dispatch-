{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "event.getaheadsup.com"
        }
      ],
      "destination": "/talk"
    },
    {
      "source": "/",
      "destination": "/dispatch"
    },
    {
      "source": "/audit",
      "destination": "/talk"
    },
    {
      "source": "/china",
      "destination": "/talk"
    },
    {
      "source": "/tools",
      "destination": "/talk"
    },
    {
      "source": "/compliance",
      "destination": "/talk"
    }
  ],
  "functions": {
    "api/digest.js": {
      "maxDuration": 60
    },
    "api/email-digest.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email-digest",
      "schedule": "0 22 * * 0-4"
    }
  ]
}
